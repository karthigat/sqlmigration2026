{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfsqlmigration2026"
		},
		"LS_SINK_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK_ADLS'"
		},
		"LS_SQL_SERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER'"
		},
		"LS_SINK_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsqlsink2026.dfs.core.windows.net/"
		},
		"LS_SQL_SERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-532UNUOO"
		},
		"LS_SQL_SERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SqlMigration2026"
		},
		"LS_SQL_SERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "karthigat"
		},
		"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/fb0c4790-8e91-4972-90f4-d3ca1985a86e/resourcegroups/rgdevchevronproject/providers/Microsoft.DataFactory/factories/adfchevronprojectdev/integrationruntimes/integrationRuntime1"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfsqlmigration2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SINK_ADLS_accountKey": {
						"value": "[parameters('LS_SINK_ADLS_accountKey')]"
					},
					"LS_SQL_SERVER_password": {
						"value": "[parameters('LS_SQL_SERVER_password')]"
					},
					"LS_SINK_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK_ADLS_properties_typeProperties_url')]"
					},
					"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('integrationRuntime1_properties_typeProperties_linkedInfo_resourceId')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_server')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}